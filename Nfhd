<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>Внешняя политика Ивана Грозного</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #000;
    font-family: 'Segoe UI', Tahoma, Arial, sans-serif;
    color: #ffffff;
  }

  .stage {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000;
  }

  .canvas {
    width: 100vw;
    height: 56.25vw;
    max-height: 100vh;
    max-width: 177.78vh;
    background: radial-gradient(circle at 20% 20%, #1a2332 0%, #0a0f16 70%);
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 60px rgba(0,0,0,0.9);
  }

  .slide {
    position: absolute;
    inset: 0;
    padding: 5vh 6vw;
    display: none;
    flex-direction: column;
    justify-content: center;
    animation: fadeIn 0.35s ease;
  }
  .slide.active { display: flex; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(1.5vh); }
    to   { opacity: 1; transform: translateY(0); }
  }

  h1 {
    font-size: 7vh;
    line-height: 1.12;
    font-weight: 800;
    background: linear-gradient(90deg, #6cb6ff, #a5d6ff, #d6ecff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 2.5vh;
    letter-spacing: -0.5px;
  }

  h2 {
    font-size: 5vh;
    color: #79c0ff;
    margin-bottom: 4.5vh;
    padding-bottom: 1.5vh;
    border-bottom: 0.5vh solid #1f6feb;
    display: inline-block;
    font-weight: 700;
  }

  h3 {
    font-size: 3.2vh;
    color: #a5d6ff;
    margin-bottom: 1.2vh;
    font-weight: 700;
  }

  p, li {
    font-size: 2.8vh;
    line-height: 1.55;
    color: #e6edf3;
  }

  ul { list-style: none; }
  li {
    margin-bottom: 2vh;
    padding-left: 4vh;
    position: relative;
  }
  li::before {
    content: "▸";
    color: #58a6ff;
    position: absolute;
    left: 0;
    font-weight: bold;
    font-size: 3vh;
  }

  .subtitle {
    font-size: 3.4vh;
    color: #b0b8c1;
    margin-top: 1.5vh;
    font-weight: 300;
    line-height: 1.4;
  }

  .highlight { color: #ffb84d; font-weight: 700; }
  .accent    { color: #7ee787; font-weight: 700; }
  .date      { color: #ffa657; font-weight: 800; }

  .card {
    background: rgba(22, 27, 34, 0.85);
    border: 0.15vh solid #30363d;
    border-radius: 1.5vh;
    padding: 2.5vh 2.5vw;
    margin-bottom: 2vh;
    box-shadow: 0 1vh 3vh rgba(0,0,0,0.5);
  }
  .card.green  { border-left: 0.8vh solid #3fb950; }
  .card.blue   { border-left: 0.8vh solid #58a6ff; }
  .card.orange { border-left: 0.8vh solid #ffa657; }
  .card.red    { border-left: 0.8vh solid #f85149; }

  .grid2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5vh 2.5vw;
    margin-bottom: 2vh;
  }

  .grid3 {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2vh 2vw;
  }

  .timeline {
    display: flex;
    justify-content: space-between;
    margin-top: 4vh;
    position: relative;
    padding: 0 1vw;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 4.5vh;
    left: 3vw; right: 3vw;
    height: 0.4vh;
    background: linear-gradient(90deg, #1f6feb, #58a6ff, #79c0ff);
    z-index: 0;
  }
  .tl-item {
    position: relative;
    z-index: 1;
    text-align: center;
    flex: 1;
    padding: 0 0.8vw;
  }
  .tl-year {
    font-size: 2.8vh;
    font-weight: 800;
    color: #ffa657;
    margin-bottom: 1vh;
  }
  .tl-dot {
    width: 2.2vh; height: 2.2vh;
    background: #58a6ff;
    border-radius: 50%;
    margin: 0 auto 1.5vh;
    box-shadow: 0 0 2.5vh #58a6ff;
    border: 0.4vh solid #0a0f16;
  }
  .tl-text {
    font-size: 2vh;
    color: #b0b8c1;
    line-height: 1.35;
  }

  .emblem {
    width: 20vh;
    height: 20vh;
    margin: 0 auto 3.5vh;
    background: radial-gradient(circle at 50% 40%, #d4a24a 0%, #8b6914 60%, #4a3a08 100%);
    border-radius: 50%;
    position: relative;
    box-shadow: 0 0 6vh rgba(212,162,74,0.55), inset 0 0 3vh rgba(0,0,0,0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10vh;
    color: #1a1408;
    font-weight: 900;
    text-shadow: 0 0.3vh 0 rgba(255,255,255,0.25);
  }

  .quote {
    font-style: italic;
    color: #b0b8c1;
    border-left: 0.8vh solid #58a6ff;
    padding-left: 2vw;
    margin: 2vh 0 0;
    font-size: 2.7vh;
    line-height: 1.5;
  }

  .big-emoji {
    font-size: 11vh;
    text-align: center;
    margin-bottom: 3vh;
    letter-spacing: 2vw;
  }

  .icon-row {
    display: flex;
    gap: 3vw;
    margin-top: 5vh;
    font-size: 7vh;
    justify-content: center;
  }

  .center { text-align: center; }

  /* ====== ФИНАЛЬНЫЙ СЛАЙД С ГИФКОЙ ====== */
  .final-slide {
    padding: 0;
    justify-content: center;
    align-items: center;
    background: #000;
    position: relative;
  }
  .final-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .final-caption {
    position: absolute;
    bottom: 3vh;
    left: 0; right: 0;
    text-align: center;
    font-size: 2.4vh;
    color: #ffffff;
    text-shadow: 0 0 1.5vh #000, 0 0 3vh #000;
    letter-spacing: 2px;
    font-weight: 600;
    z-index: 2;
  }

  .progress {
    position: absolute;
    top: 0; left: 0;
    height: 0.8vh;
    background: linear-gradient(90deg, #1f6feb, #58a6ff, #79c0ff);
    transition: width 0.3s;
    z-index: 100;
    box-shadow: 0 0 1.5vh #58a6ff;
  }

  .counter {
    position: absolute;
    bottom: 2vh;
    right: 2.5vw;
    color: #8b949e;
    font-size: 2vh;
    z-index: 100;
    letter-spacing: 1px;
    background: rgba(0,0,0,0.5);
    padding: 0.6vh 1.2vw;
    border-radius: 2vh;
  }

  .controls {
    position: absolute;
    bottom: 2vh;
    left: 2.5vw;
    display: flex;
    gap: 0.8vw;
    z-index: 100;
    opacity: 0.25;
    transition: opacity 0.3s;
  }
  .controls:hover { opacity: 1; }
  .controls button {
    background: rgba(33, 38, 45, 0.9);
    color: #e6edf3;
    border: 0.15vh solid #30363d;
    padding: 0.9vh 1.3vw;
    font-size: 2vh;
    border-radius: 0.8vh;
    cursor: pointer;
    transition: all 0.2s;
  }
  .controls button:hover {
    background: #1f6feb;
    border-color: #58a6ff;
  }
</style>
</head>
<body>

<div class="stage">
  <div class="canvas" id="canvas">
    <div class="progress" id="progress"></div>

    <!-- СЛАЙД 1. ТИТУЛ -->
    <div class="slide active">
      <div class="center">
        <div class="emblem">☦</div>
        <h1>Внешняя политика Ивана Грозного</h1>
        <p class="subtitle">Расширение границ Русского государства в XVI веке</p>
        <p style="margin-top:4vh; color:#8b949e; font-size:2.6vh;">1533–1584 • От Казани до Сибири</p>
      </div>
    </div>

    <!-- СЛАЙД 2. НАПРАВЛЕНИЯ -->
    <div class="slide">
      <h2>Три главных направления</h2>
      <div class="grid3">
        <div class="card blue">
          <h3>🕌 Восточное</h3>
          <p>Борьба с Казанским и Астраханским ханствами. Контроль над Волжским торговым путём.</p>
        </div>
        <div class="card orange">
          <h3>⚔️ Западное</h3>
          <p>Ливонская война за выход к Балтийскому морю и земли Прибалтики.</p>
        </div>
        <div class="card green">
          <h3>🛡️ Южное</h3>
          <p>Оборона от набегов Крымского ханства и Османской империи.</p>
        </div>
      </div>
    </div>

    <!-- СЛАЙД 3. КАЗАНЬ -->
    <div class="slide">
      <h2>Взятие Казани — <span class="date">1552</span></h2>
      <ul>
        <li>Казанское ханство совершало постоянные набеги на русские земли.</li>
        <li><span class="highlight">2 октября 1552 года</span> — Казань взята штурмом после 43-дневной осады.</li>
        <li>Иван Грозный лично участвовал в походе.</li>
        <li>Ханство присоединено к Русскому государству.</li>
      </ul>
      <div class="card green" style="margin-top:2.5vh;">
        <p><span class="accent">Итог:</span> устранена угроза с востока, открыт путь на Урал и в Сибирь.</p>
      </div>
    </div>

    <!-- СЛАЙД 4. АСТРАХАНЬ -->
    <div class="slide">
      <h2>Присоединение Астрахани — <span class="date">1556</span></h2>
      <ul>
        <li>Астраханское ханство контролировало нижнее течение Волги.</li>
        <li>В <span class="highlight">1554</span> — первый поход, установление зависимости ханства от Москвы.</li>
        <li>В <span class="highlight">1556</span> — окончательное присоединение.</li>
        <li>Вся Волга — от истоков до Каспия — стала русской рекой.</li>
      </ul>
      <div class="card blue" style="margin-top:2.5vh;">
        <p><span class="accent">Итог:</span> контроль над торговым путём в Персию и Среднюю Азию.</p>
      </div>
    </div>

    <!-- СЛАЙД 5. ЛИВОНСКАЯ ВОЙНА -->
    <div class="slide">
      <h2>Ливонская война — <span class="date">1558–1583</span></h2>
      <ul>
        <li><span class="highlight">Причина:</span> выход к Балтийскому морю для торговли с Европой.</li>
        <li><span class="highlight">1558–1561:</span> разгром Ливонского ордена, взятие Нарвы и Дерпта.</li>
        <li><span class="highlight">1563:</span> взятие Полоцка.</li>
        <li>Против России — Литва, Польша, Швеция, Дания.</li>
        <li><span class="highlight">1582–1583:</span> Ям-Запольское и Плюсское перемирия.</li>
      </ul>
      <div class="card red" style="margin-top:2vh;">
        <p><span style="color:#f85149; font-weight:700;">Итог:</span> война проиграна. Россия потеряла часть земель и не получила выхода к Балтике.</p>
      </div>
    </div>

    <!-- СЛАЙД 6. КРЫМ -->
    <div class="slide">
      <h2>Южное направление: борьба с Крымом</h2>
      <ul>
        <li>Крымское ханство — вассал Османской империи.</li>
        <li>Постоянные набеги на южные земли Руси.</li>
        <li><span class="highlight">1571</span> — сожжение Москвы ханом Девлет-Гиреем.</li>
        <li><span class="highlight">1572</span> — победа русских войск в битве при Молодях.</li>
        <li>Для защиты построена <span class="accent">Большая засечная черта</span> — линия обороны.</li>
      </ul>
    </div>

    <!-- СЛАЙД 7. СИБИРЬ -->
    <div class="slide">
      <h2>Поход Ермака в Сибирь — <span class="date">1581–1585</span></h2>
      <ul>
        <li>Сибирское ханство — сосед на востоке.</li>
        <li>Купцы <span class="highlight">Строгановы</span> финансируют поход казаков.</li>
        <li>Атаман <span class="highlight">Ермак Тимофеевич</span> возглавляет отряд.</li>
        <li><span class="highlight">1582</span> — разгром хана Кучума, взятие Кашлыка.</li>
        <li>Начало присоединения Сибири к России.</li>
      </ul>
      <div class="card green" style="margin-top:2.5vh;">
        <p><span class="accent">Значение:</span> начало освоения огромных территорий за Уралом.</p>
      </div>
    </div>

    <!-- СЛАЙД 8. ИТОГИ -->
    <div class="slide">
      <h2>Итоги внешней политики</h2>
      <div class="grid2">
        <div class="card green">
          <h3>✅ Успехи</h3>
          <p>Присоединены Казанское и Астраханское ханства. Начато освоение Сибири. Волга стала русской рекой.</p>
        </div>
        <div class="card red">
          <h3>❌ Неудачи</h3>
          <p>Ливонская война проиграна. Выход к Балтике не получен. Южные земли страдали от набегов.</p>
        </div>
      </div>
      <div class="card blue" style="margin-top:1vh;">
        <h3>📌 Значение</h3>
        <p>Россия превратилась в <span class="highlight">многонациональное государство</span> и крупную евразийскую державу.</p>
      </div>
    </div>

    <!-- СЛАЙД 9. СПАСИБО -->
    <div class="slide">
      <div class="center">
        <h1>Спасибо за внимание!</h1>
        <p class="subtitle">Вопросы?</p>
        <div class="icon-row">👑 ⚔️ 🛡️ 🗺️</div>
      </div>
    </div>

    <!-- СЛАЙД 10. ФИНАЛЬНАЯ ГИФКА -->
    <div class="slide final-slide">
      <!-- ⚠️ Положи файл final.gif рядом с HTML -->
      <img src="final.gif" alt="Финал" onerror="this.style.display='none';this.nextElementSibling.style.display='block';">
      <div style="display:none; color:#4a5568; text-align:center;">
        <span style="font-size:10vh; display:block; margin-bottom:2vh;">🎬</span>
        <div style="font-size:2.4vh; letter-spacing:1px;">ПОЛОЖИ СЮДА final.gif</div>
      </div>
      <div class="final-caption">Конец презентации</div>
    </div>

    <div class="controls">
      <button onclick="prev()">← Назад</button>
      <button onclick="next()">Вперёд →</button>
    </div>

    <div class="counter"><span id="current">1</span> / <span id="total">10</span></div>
  </div>
</div>

<script>
  const slides = document.querySelectorAll('.slide');
  const total = slides.length;
  let index = 0;

  document.getElementById('total').textContent = total;

  function show(i) {
    slides.forEach(s => s.classList.remove('active'));
    slides[i].classList.add('active');
    document.getElementById('current').textContent = i + 1;
    document.getElementById('progress').style.width = ((i + 1) / total * 100) + '%';
  }

  function next() { if (index < total - 1) { index++; show(index); } }
  function prev() { if (index > 0) { index--; show(index); } }

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown' || e.key === 'Enter') {
      e.preventDefault(); next();
    }
    if (e.key === 'ArrowLeft' || e.key === 'PageUp' || e.key === 'Backspace') {
      e.preventDefault(); prev();
    }
    if (e.key === 'Home') { index = 0; show(0); }
    if (e.key === 'End')  { index = total - 1; show(index); }
    if (e.key === 'f' || e.key === 'F' || e.key === 'F11') {
      e.preventDefault();
      if (!document.fullscreenElement) document.documentElement.requestFullscreen();
      else document.exitFullscreen();
    }
  });

  show(0);
</script>

</body>
</html>
